# my.telegram.org -> API development tools (for the userbot account)
TG_API_ID=
TG_API_HASH=

# @BotFather token of the bot that writes to you
BOT_TOKEN=
# your numeric Telegram id (the bot only talks to you)
OWNER_ID=

# Where to read vacancies from: a Telegram folder title (shared via t.me/addlist/...)
# and/or a comma-separated list of @usernames / invite-free chat ids
TG_FOLDER=
TG_SOURCES=

TZ=Asia/Yerevan
DATA_DIR=data

# hh.ru: User-Agent must identify the app and contain a contact email
HH_USER_AGENT=JobPilot/0.1 (you@example.com)
# optional app token from https://dev.hh.ru (register an application)
HH_APP_TOKEN=
# optional: use the installed Google Chrome instead of the bundled Chromium for hh logins
HH_BROWSER_CHANNEL=

# Site (jobpilot web, v3): password to log in, at least 8 characters
WEB_PASSWORD=
# how long a login lasts, hours
WEB_SESSION_HOURS=24
# where docker publishes the site: 8080 = open on the server IP, 127.0.0.1:8080 = only through an ssh tunnel
WEB_PUBLISH=8080

# Job-site feeds (v9): User-Agent for reading the RSS feeds (default identifies JobPilot as an RSS reader)
FEEDS_USER_AGENT=
